---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
interface Props { title: string; description: string; image?: string; imageAlt?: string; type?: string; schema?: object[]; noindex?: boolean }
const { title, description, image = '/og-default.png', imageAlt = 'ZentaCircuits', type = 'website', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const img = new URL(image, SITE.url).href;
const robots = !SITE.launched ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url, logo: `${SITE.url}/icon-512.png` };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#E11D48" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={img} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify([org, ...schema])} />
  {SITE.ga4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`}></script>}
  {SITE.ga4 && <script is:inline define:vars={{ id: SITE.ga4 }}>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', id);</script>}
  {SITE.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
