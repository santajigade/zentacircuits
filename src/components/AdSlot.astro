---
import { SITE } from '../data/site';
const { label = 'Ad', height = 110 } = Astro.props;
---
{SITE.adsenseClient ? (
  <div style={`min-height:${height}px;margin:28px 0`}>
    <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsenseClient} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : SITE.showAdPlaceholders && <div class="ad" style={`min-height:${height}px`}>{label}</div>}
