---
import Logo from './Logo.astro';
import { CATEGORIES } from '../data/categories';
import { SITE } from '../data/site';
---
<footer class="ftr">
  <div class="wrap cols">
    <div>
      <Logo dark />
      <p>{SITE.description}</p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <div class="col"><span>Learn</span>{CATEGORIES.slice(0, 6).map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}</div>
    <div class="col"><span>More</span>{CATEGORIES.slice(6).map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}</div>
    <div class="col"><span>About</span><a href="/about/">About us</a><a href="/editorial-policy/">Editorial policy</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy policy</a><a href="/terms-of-use/">Terms of use</a><a href="/disclaimer/">Disclaimer</a></div>
  </div>
  <div class="wrap base">© {new Date().getFullYear()} {SITE.name}. Free electronics learning.</div>
</footer>
<style>
  .ftr { background: var(--ink); color: #cbd5e1; margin-top: 64px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; padding-top: 56px; padding-bottom: 28px; font-size: 15px; }
  .col { display: flex; flex-direction: column; gap: 8px; }
  .col span { color: #fff; font-weight: 600; }
  a { color: #cbd5e1; text-decoration: none; }
  a:hover { color: #fff; }
  .base { border-top: 1px solid #1e293b; padding-top: 20px; padding-bottom: 32px; font-size: 14px; }
</style>
