---
import Logo from './Logo.astro';
import { CATEGORIES } from '../data/categories';
import { liveArticles } from '../lib/content';
const live = new Set((await liveArticles()).map((a) => `${a.data.category}/${a.data.subcategory}`));
const subHref = (c: string, s: string) => (live.has(`${c}/${s}`) ? `/${c}/${s}/` : `/${c}/`);
---
<header class="hdr">
  <div class="wrap row">
    <a href="/" class="home" aria-label="ZentaCircuits home"><Logo /></a>
    <nav aria-label="Main" class="nav">
      <div class="mm" data-mm>
        <button type="button" class="mm-btn" aria-expanded="false" aria-controls="mm-panel">Learn <span aria-hidden="true">▾</span></button>
        <div class="mm-panel" id="mm-panel">
          <div class="wrap mm-grid">
            {CATEGORIES.map((c) => (
              <div class="mm-col">
                <a class="mm-cat" href={`/${c.slug}/`}>
                  <span class="mm-ic" style={`background:${c.color}`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg></span>
                  {c.name}
                </a>
                <ul>
                  {c.subs.slice(0, 5).map((s) => <li><a href={subHref(c.slug, s.slug)}>{s.name}</a></li>)}
                  {c.subs.length > 5 && <li><a class="mm-all" href={`/${c.slug}/`} style={`color:${c.color}`}>All {c.short} topics →</a></li>}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
      <a href="/simulators/">Simulators</a>
      <a href="/calculators/">Calculators</a>
      <a href="/about/">About</a>
    </nav>
    <a href="/search/" class="icon" aria-label="Search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
    </a>
    <a href="/basics/" class="btn btn-red start">Start learning</a>
  </div>
</header>
<script>
  // Mega menu: opens on hover (desktop) or click/tap; closes on mouse leave, outside click or Escape.
  const mm = document.querySelector<HTMLElement>('[data-mm]');
  if (mm) {
    const btn = mm.querySelector<HTMLButtonElement>('.mm-btn')!;
    const hover = matchMedia('(hover: hover) and (min-width: 900px)');
    let timer = 0;
    const set = (open: boolean) => { mm.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open)); };
    mm.addEventListener('mouseenter', () => { if (hover.matches) { clearTimeout(timer); set(true); } });
    mm.addEventListener('mouseleave', () => { if (hover.matches) timer = window.setTimeout(() => set(false), 150); });
    btn.addEventListener('click', () => set(!mm.classList.contains('open')));
    document.addEventListener('click', (e) => { if (!mm.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn.focus(); } });
    mm.addEventListener('focusout', (e) => { if (!mm.contains(e.relatedTarget as Node)) set(false); });
  }
</script>
<style>
  .hdr { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 30; }
  .row { display: flex; align-items: center; gap: 24px; padding-top: 12px; padding-bottom: 12px; flex-wrap: wrap; position: relative; }
  .home { text-decoration: none; }
  .nav { display: flex; gap: 22px; flex: 1 1 auto; align-items: center; flex-wrap: wrap; }
  .nav > a, .mm-btn { color: var(--ink); text-decoration: none; font: 16px var(--sans); }
  .nav > a:hover, .mm-btn:hover { color: var(--red-dark); }
  .mm-btn { background: none; border: 0; padding: 10px 0; cursor: pointer; }
  .mm-btn span { font-size: 12px; display: inline-block; transition: transform .15s; }
  .mm.open .mm-btn { color: var(--red-dark); }
  .mm.open .mm-btn span { transform: rotate(180deg); }
  .mm-panel { display: none; position: fixed; left: 0; right: 0; top: var(--hdr-h, 69px); background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); box-shadow: 0 18px 40px rgba(15, 23, 42, .10); max-height: calc(100vh - 80px); overflow-y: auto; }
  .mm.open .mm-panel { display: block; }
  .mm-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 24px; padding-top: 28px; padding-bottom: 28px; }
  .mm-cat { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; color: var(--ink); text-decoration: none; margin-bottom: 8px; }
  .mm-cat:hover { color: var(--red-dark); }
  .mm-ic { flex: 0 0 28px; width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; }
  .mm-col ul { list-style: none; margin: 0; padding: 0 0 0 38px; }
  .mm-col li a { display: block; padding: 3px 0; font-size: 14px; color: var(--muted); text-decoration: none; }
  .mm-col li a:hover { color: var(--red-dark); }
  .mm-all { font-weight: 600; }
  .icon { width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--ink); }
  @media (max-width: 1100px) { .mm-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .mm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .start { display: none; } }
  @media (max-width: 700px) {
    .hdr { position: static; }
    .row { gap: 10px 14px; padding-top: 10px; padding-bottom: 6px; }
    .home { flex: 1 1 auto; }
    .nav { order: 3; flex: 1 1 100%; gap: 18px; flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; }
    .nav > a, .mm-btn { font-size: 15px; white-space: nowrap; }
    .mm-panel { position: fixed; top: var(--hdr-h, 110px); }
  }
  @media (max-width: 560px) { .mm-grid { grid-template-columns: 1fr; } }
</style>
<script>
  // Keep the mega menu right under the header, whatever its height.
  const h = document.querySelector<HTMLElement>('.hdr');
  const sync = () => h && document.documentElement.style.setProperty('--hdr-h', `${h.getBoundingClientRect().bottom}px`);
  sync(); addEventListener('resize', sync); addEventListener('scroll', sync, { passive: true });
</script>
