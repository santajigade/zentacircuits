---
import Logo from './Logo.astro';
import { CATEGORIES } from '../data/categories';
---
<header class="hdr">
  <div class="wrap row">
    <a href="/" class="home" aria-label="ZentaCircuits home"><Logo /></a>
    <nav aria-label="Main" class="nav">
      <details class="mega">
        <summary>Learn</summary>
        <div class="panel">
          {CATEGORIES.map((c) => (
            <a href={`/${c.slug}/`}><span class="dot" style={`background:${c.color}`}></span>{c.name}</a>
          ))}
        </div>
      </details>
      <a href="/simulators/">Simulators</a>
      <a href="/calculators/">Calculators</a>
      <a href="/about/">About</a>
    </nav>
    <a href="/search/" class="icon" aria-label="Search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
    </a>
    <a href="/basics/" class="btn btn-red start">Start learning</a>
  </div>
</header>
<style>
  .hdr { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .row { display: flex; align-items: center; gap: 24px; padding-top: 12px; padding-bottom: 12px; flex-wrap: wrap; }
  .home { text-decoration: none; }
  .nav { display: flex; gap: 22px; flex: 1 1 auto; align-items: center; flex-wrap: wrap; }
  .nav > a, summary { color: var(--ink); text-decoration: none; font-size: 16px; cursor: pointer; }
  .mega { position: relative; }
  summary { list-style: none; }
  summary::after { content: ' ▾'; font-size: 12px; }
  .panel { position: absolute; top: 34px; left: -16px; width: 560px; max-width: 90vw; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 14px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; box-shadow: 0 10px 30px rgba(15, 23, 42, .08); }
  .panel a { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; color: var(--ink); text-decoration: none; font-size: 15px; }
  .panel a:hover { background: var(--paper); }
  .dot { width: 10px; height: 10px; border-radius: 50%; flex: 0 0 10px; }
  .icon { width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--ink); }
  @media (max-width: 700px) { .start { display: none; } .panel { grid-template-columns: 1fr; width: 280px; } }
</style>
