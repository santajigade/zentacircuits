---
import type { Author } from '../data/site';
interface Props { au: Author }
const { au } = Astro.props;
const li = 'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.84-2.05 3.8-2.05 4.06 0 4.8 2.67 4.8 6.15V21h-4v-5.6c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9z';
---
<section class="ab" aria-label="About the author">
  <img class="ph" src={au.photo} alt={`${au.name}, ${au.title}`} width="120" height="120" loading="lazy" />
  <div class="tx">
    <p class="k">Written by</p>
    <p class="nm">{au.name}</p>
    <p class="ti">{au.title} · {au.role}</p>
    <p class="bio">{au.bio}</p>
    <div class="tags">{au.topics.map((t) => <span>{t}</span>)}</div>
    <div class="btns">
      <a class="b1" href={`/author/${au.slug}/`}>More articles by {au.name.split(' ')[0]}</a>
      <a class="b2" href={au.linkedin} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={li} fill="currentColor" /></svg> Connect on LinkedIn</a>
    </div>
  </div>
</section>
<style>
  .ab { position: relative; display: flex; gap: 28px; align-items: flex-start; flex-wrap: wrap; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 30px 30px 26px; margin: 40px 0 24px; box-shadow: 0 10px 30px rgba(15, 23, 42, .06); overflow: hidden; }
  .ab::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--ink); }
  .ph { flex: 0 0 120px; width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 1px solid var(--line); padding: 4px; background: #fff; box-shadow: 0 6px 18px rgba(15, 23, 42, .10); }
  .tx { flex: 1 1 320px; min-width: 0; }
  .k { margin: 0 0 2px; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .nm { margin: 0; font-size: 26px; font-weight: 700; color: var(--ink); }
  .ti { margin: 2px 0 10px; font-size: 15px; font-weight: 500; color: var(--muted); }
  .bio { margin: 0 0 14px; font-size: 16px; line-height: 1.65; color: var(--text); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .tags span { font-size: 13px; font-weight: 500; color: #334155; background: #F1F5F9; border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .btns a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 8px; font-weight: 600; font-size: 15px; text-decoration: none; }
  .b1 { background: var(--ink); color: #fff; }
  .b1:hover { background: #1E293B; color: #fff; }
  .b2 { background: #0A66C2; color: #fff; }
  .b2:hover { background: #084d93; color: #fff; }
  @media (max-width: 560px) { .ab { padding: 26px 20px 22px; } .ph { flex-basis: 96px; width: 96px; height: 96px; } }
</style>
