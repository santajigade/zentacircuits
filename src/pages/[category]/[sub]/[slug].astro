---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Newsletter from '../../../components/Newsletter.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { liveArticles, articleUrl, featuredSrc, slugOf, type Article } from '../../../lib/content';
import { catBySlug, subName } from '../../../data/categories';
import { AUTHORS, SITE } from '../../../data/site';

export async function getStaticPaths() {
  const list = await liveArticles();
  return list.map((a) => ({ params: { category: a.data.category, sub: a.data.subcategory, slug: slugOf(a) }, props: { a, all: list } }));
}
const { a, all } = Astro.props as { a: Article; all: Article[] };
const d = a.data;
const { Content, headings } = await render(a);
const cat = catBySlug(d.category);
const author = AUTHORS[d.author];
const url = articleUrl(a);
const img = featuredSrc(a);
const toc = headings.filter((h) => h.depth === 2);
const more = all.filter((x) => x.id !== a.id && x.data.subcategory === d.subcategory && x.data.category === d.category).slice(0, 4);
const fmt = (x: Date) => x.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const abs = (p: string) => new URL(p, SITE.url).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'TechArticle', headline: d.title, description: d.description, image: [abs(img)],
    datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@type': 'Person', name: author.name, url: abs(`/author/${author.slug}/`), sameAs: [author.linkedin] },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: abs('/icon-512.png') } },
    mainEntityOfPage: abs(url), educationalLevel: d.level, isAccessibleForFree: true, inLanguage: 'en' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: cat.name, item: abs(`/${cat.slug}/`) },
    { '@type': 'ListItem', position: 3, name: subName(d.category, d.subcategory), item: abs(`/${cat.slug}/${d.subcategory}/`) },
    { '@type': 'ListItem', position: 4, name: d.title, item: abs(url) } ] },
  ...(d.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base title={d.seoTitle ?? `${d.title} | ${SITE.name}`} description={d.description} image={img} imageAlt={d.image.alt} type="article" schema={schema}>
  <div class="wrap crumbs-wrap">
    <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a><span>›</span><a href={`/${cat.slug}/`}>{cat.name}</a><span>›</span><a href={`/${cat.slug}/${d.subcategory}/`}>{subName(d.category, d.subcategory)}</a><span>›</span><span>{d.title.split(':')[0]}</span></nav>
  </div>
  <div class="wrap layout">
    <article class="main" data-pagefind-body>
      <p class="eyebrow" style={`color:${cat.color};font-weight:600`}>{cat.name} · {subName(d.category, d.subcategory)}</p>
      <h1>{d.title}</h1>
      <div class="byline">
        <span class="av" aria-hidden="true">{author.initials}</span>
        <span>By <a href={`/author/${author.slug}/`}>{author.name}</a>, {author.role.replace('B.E. Electronics and Telecommunication', 'B.E. E&TC')}</span>
        <span>Published {fmt(d.pubDate)}</span>
        {d.updatedDate && <span>Updated {fmt(d.updatedDate)}</span>}
        <span>{d.readMinutes} min read</span>
        <span class="lvl">{d.level}</span>
      </div>
      <div class="share">
        <a href={`https://wa.me/?text=${encodeURIComponent(d.title + ' ' + abs(url))}`} rel="noopener" target="_blank">WhatsApp</a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(abs(url))}`} rel="noopener" target="_blank">LinkedIn</a>
        <a href={`https://x.com/intent/post?url=${encodeURIComponent(abs(url))}&text=${encodeURIComponent(d.title)}`} rel="noopener" target="_blank">X</a>
      </div>
      <figure class="feat">
        <img src={img} alt={d.image.alt} width="1200" height="675" fetchpriority="high" />
      </figure>
      <div class="answer">
        <p class="eyebrow" style="color:var(--red-dark)">Short answer</p>
        <p>{d.shortAnswer}</p>
      </div>
      {(d.prerequisites.length > 0 || d.simulator) && (
        <div class="pre">
          {d.prerequisites.length > 0 && <span class="muted">Before this:</span>}
          {d.prerequisites.map((p) => <a class="chip" href={p.href}>{p.name}</a>)}
          {d.simulator && <a class="jump" href="#simulator">Jump to simulator ↓</a>}
        </div>
      )}
      <AdSlot label="Ad slot 1" />
      <div class="prose">
        {d.learn.length > 0 && (<><h2 id="what-you-will-learn">What you will learn</h2><ul>{d.learn.map((l) => <li>{l}</li>)}</ul></>)}
        <Content />
        {d.interview.length > 0 && (<><h2 id="interview-questions">Interview and viva questions</h2><ol>{d.interview.map((q) => <li>{q}</li>)}</ol></>)}
        <AdSlot label="Ad slot 3" />
        {d.faq.length > 0 && (<><h2 id="faq">FAQ</h2>{d.faq.map((f, i) => <details class="faq" open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</>)}
        <h2 id="references">References</h2>
        <ol>{d.references.map((r) => <li>{r.url ? <a href={r.url}>{r.text}</a> : r.text}</li>)}</ol>
      </div>
      <div class="authorbox card">
        <span class="av big" aria-hidden="true">{author.initials}</span>
        <div><p class="an">{author.name}</p><p class="muted">{author.role}</p><p>{author.bio}</p><a href={author.linkedin} rel="noopener" target="_blank">LinkedIn</a> · <a href="/editorial-policy/">Editorial policy</a></div>
      </div>
      <Newsletter />
      {(d.prev || d.next) && (
        <div class="pn">
          {d.prev ? <a class="card" href={d.prev.href}><span class="muted">← Previous</span><b>{d.prev.name}</b></a> : <span></span>}
          {d.next && <a class="card r" href={d.next.href}><span class="muted">Next →</span><b>{d.next.name}</b></a>}
        </div>
      )}
      {more.length > 0 && (<><h2 class="more-h">More in {subName(d.category, d.subcategory)}</h2><ul class="more">{more.map((m) => <li><a href={articleUrl(m)}>{m.data.title}</a></li>)}</ul></>)}
    </article>
    <aside class="side" aria-label="Sidebar">
      <div class="card toc">
        <p class="tt">On this page</p>
        <ol>{(d.learn.length ? [{ slug: 'what-you-will-learn', text: 'What you will learn' }] : []).concat(toc).concat(d.faq.length ? [{ slug: 'faq', text: 'FAQ' }] : []).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </div>
      <Newsletter compact />
      <AdSlot label="Sidebar ad" height={250} />
    </aside>
  </div>
</Base>
<style>
  .crumbs-wrap { padding-top: 24px; }
  .crumbs { font-size: 14px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px; }
  .layout { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; padding-top: 20px; }
  .main { flex: 999 1 640px; min-width: 0; }
  .side { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 20px; position: sticky; top: 84px; }
  h1 { margin: 0 0 18px; font-weight: 700; font-size: clamp(32px, 4vw, 44px); line-height: 1.15; }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; font-size: 15px; color: var(--muted); }
  .av { width: 44px; height: 44px; border-radius: 50%; background: var(--line); display: inline-flex; align-items: center; justify-content: center; font-weight: 600; color: var(--ink); }
  .av.big { width: 72px; height: 72px; font-size: 22px; flex: 0 0 72px; }
  .lvl { background: var(--red-tint); color: var(--red-deep); padding: 4px 10px; border-radius: 999px; font-weight: 600; }
  .share { display: flex; gap: 8px; margin: 16px 0 24px; flex-wrap: wrap; }
  .share a { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; font-size: 14px; text-decoration: none; color: var(--ink); background: #fff; }
  .feat { margin: 0 0 24px; }
  .feat img { display: block; width: 100%; height: auto; border-radius: 16px; }
  .answer { background: #fff; border: 1.5px solid var(--red); border-radius: 16px; padding: 22px 24px; font-size: 18px; line-height: 1.7; }
  .answer p:last-child { margin: 0; }
  .pre { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 20px 0; font-size: 15px; }
  .muted { color: var(--muted); }
  .jump { margin-left: auto; font-weight: 600; }
  .faq { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; margin: 0 0 10px; }
  .faq summary { font-weight: 600; cursor: pointer; }
  .faq p { margin: 8px 0 0; }
  .authorbox { display: flex; gap: 18px; padding: 22px; margin-top: 40px; flex-wrap: wrap; }
  .authorbox p { margin: 0 0 6px; }
  .an { font-weight: 600; font-size: 19px; }
  .pn { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .pn a { padding: 18px; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; }
  .pn .r { text-align: right; }
  .more-h { font-size: 24px; margin: 36px 0 12px; }
  .toc { padding: 20px; }
  .tt { margin: 0 0 10px; font-weight: 600; font-size: 17px; }
  .toc ol { margin: 0; padding-left: 20px; font-size: 15px; line-height: 2; }
  @media (max-width: 980px) { .side { position: static; } .side :global(.nl) { display: none; } }
</style>
