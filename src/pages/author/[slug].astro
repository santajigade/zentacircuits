---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { AUTHORS, SITE, type Author } from '../../data/site';
import { liveArticles } from '../../lib/content';
export function getStaticPaths() { return Object.values(AUTHORS).map((a) => ({ params: { slug: a.slug }, props: { au: a } })); }
const { au } = Astro.props as { au: Author };
const list = (await liveArticles()).filter((a) => a.data.author === au.slug);
const schema = [{ '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: { '@type': 'Person', name: au.name, jobTitle: au.title, image: `${SITE.url}${au.photo}`, sameAs: [au.linkedin] } }];
---
<Base title={`${au.name}, Author | ${SITE.name}`} description={`${au.name}, ${au.role}. ${au.bio}`.slice(0, 158)} schema={schema}>
  <div class="wrap" style="padding-top:40px">
    <h1 style="font-size:36px;margin:0">{au.name}</h1>
    <AuthorBox au={au} />
    <h2 style="font-size:26px;margin:8px 0 18px">Articles by {au.name.split(' ')[0]}</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px">{list.map((a) => <ArticleCard a={a} />)}</div>
  </div>
</Base>
