---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title={`Electronics Calculators | ${SITE.name}`} description="Electronics calculators that fill the gaps in our lessons, from number base conversion to K map solving." noindex>
  <div class="wrap" style="padding-top:40px;max-width:820px">
    <h1 style="font-size:40px;margin:0 0 12px">Calculators</h1>
    <p style="font-size:18px;color:var(--muted)">Calculators are being added alongside the lessons that use them.</p>
  </div>
</Base>
