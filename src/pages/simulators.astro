---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title={`Electronics Simulators | ${SITE.name}`} description="Browser based electronics simulators with live waveforms, cursors and theory vs simulated checks." noindex>
  <div class="wrap" style="padding-top:40px;max-width:820px">
    <h1 style="font-size:40px;margin:0 0 12px">Simulators</h1>
    <p style="font-size:18px;color:var(--muted)">Our first simulators are in final testing. Each one goes live only after it passes its textbook test cases.</p>
  </div>
</Base>
